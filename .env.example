# 이 파일을 .env로 복사한 뒤 실제 봇 토큰과 채널 ID를 입력합니다.
DISCORD_TOKEN=
NOTICE_CHANNEL_ID=
ABYSS_CHANNEL_ID=
SERVER_STATUS_CHANNEL_ID=

# 시세 조회에 필요한 OpenAPI 키입니다. 룬 통계에는 필요하지 않습니다.
MOBLIFE_API_KEY=

# 상대 경로는 프로젝트 폴더 기준입니다. Railway에서는 /data/data.db를 사용합니다.
DB_FILE=data.db

# 빈 값이면 모비라이프에 직접 연결합니다.
MOBLIFE_PROXY_BASE=https://moblife-proxy.ninemailz.workers.dev
# MOBLIFE_EAB_KEY=
TZ=Asia/Seoul
